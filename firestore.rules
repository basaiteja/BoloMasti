rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function member(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }
    function canMarkQueueMatch(uid) {
      return signedIn()
        && request.resource.data.status == 'matched'
        && request.resource.data.matchId is string
        && queueMatchIsValid(uid, request.resource.data.matchId);
    }
    function queueMatchIsValid(uid, conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
      let ownQueue = get(/databases/$(database)/documents/matchQueue/$(request.auth.uid));
      return resource.data.uid == uid
        && resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'matchId'])
        && ownQueue.data.status == 'waiting'
        && conversation.data.members is list
        && conversation.data.members.size() == 2
        && request.auth.uid in conversation.data.members
        && uid in conversation.data.members;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
      match /following/{followedUid} {
        allow read: if signedIn();
        allow create: if isSelf(uid) && request.resource.data.uid == followedUid;
        allow delete: if isSelf(uid);
        allow update: if false;
      }
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if isSelf(followerUid) && request.resource.data.uid == followerUid;
        allow delete: if isSelf(followerUid);
        allow update: if false;
      }
    }
    match /matchQueue/{uid} {
      allow read: if signedIn();
      allow create, delete: if isSelf(uid);
      allow update: if isSelf(uid) || canMarkQueueMatch(uid);
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if member(conversationId);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if member(conversationId);
        allow create: if member(conversationId) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.photoURL is string;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid) && request.resource.data.uid == uid;
        allow delete: if isSelf(uid);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
        allow update: if false;
      }
    }
    match /callLogs/{uid}/items/{logId} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }
    match /calls/{conversationId} {
      allow read, create, update: if member(conversationId);
      allow delete: if false;
      match /{document=**} { allow read, write: if member(conversationId); }
    }
  }
}
